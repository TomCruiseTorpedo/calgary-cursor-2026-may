.DS_Store
.env
node_modules/
dist/
package-lock.json.bak

# Local env and OS
.env.local
.env.*.local

# Group Code (extension metadata; optional to track)
.groupcode/

# ECC / Cursor local harness — reinstall via docs/ECC-SETUP.md
.cursor/

# Local-only notes — never publish
docs/private/

# ECC transient hook state (if any path leaks outside .cursor)
**/.cursor/hooks/state/

# Runtime intake artifacts (specs + screenshots from local demos)
.spec-workflow/specs/requests/*.md
.spec-workflow/specs/requests/attachments/*
!.spec-workflow/specs/requests/attachments/.gitkeep
